{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@krypton/schema": ["./packages/schema/src/index.ts"],
      "@krypton/engine": ["./packages/engine/src/index.ts"],
      "@krypton/nodes-core": ["./packages/nodes-core/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "apps/docs"]
}
