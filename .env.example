# Copy to .env for local development. Never commit the real file.
POSTGRES_DB=krypton
POSTGRES_USER=krypton
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Keep the port and password in these URLs in sync with the POSTGRES_* values.
DATABASE_URL=postgres://krypton:change-me@127.0.0.1:5432/krypton
# Integration tests remove the public and Drizzle bookkeeping schemas. Use a disposable database.
# They require a loopback host unless TEST_DATABASE_ALLOW_REMOTE=true is set below.
TEST_DATABASE_URL=postgres://krypton:change-me@127.0.0.1:5432/krypton_test
# TEST_DATABASE_ALLOW_REMOTE=true
